# Base URL for API calls. In dev, "/api" is proxied to the backend
# (see vite.config.js). Set to a full URL in production, e.g.
# https://api.yourdomain.com/api
VITE_API_URL=/api

# Razorpay public key (safe to expose in the frontend). Used to open
# the Razorpay checkout. The SECRET must never be placed here.
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
