# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── MySQL Database ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gearnix

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_RESET_SECRET=change_this_to_another_long_random_secret
JWT_RESET_EXPIRES_IN=15m

# ─── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Super Admin seed (used by: npm run seed:admin) ───────
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@gearnix.com
ADMIN_PASSWORD=Admin@123
